# Copy to backend/.env to override defaults
CANTEEN_DB=./canteen.db
SLOT_CAPACITY=10
SLOT_START_HOUR=11
SLOT_END_HOUR=15
# If true, slots whose end time has already passed (today) cannot be booked.
# Default false so the 1:00-1:15 PM demo works at any time of day.
ENFORCE_PAST_SLOTS=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATASET_PATH=../data/canteen_fake_data_30_days.xlsx
